# ==============================================================================
# Pilot Mama V1 - Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT REAL PRODUCTION SECRETS TO REPOSITORY.
# Copy this file to .env or backend/.env and populate with deployment variables.

# Runtime Environment (development | test | production)
NODE_ENV=development

# Server Port
PORT=5000

# PostgreSQL Connection String (Prisma format)
# Local: postgresql://postgres:postgres@localhost:5432/pilotmama?schema=public
# Production: Render Managed PostgreSQL connection string with SSL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pilotmama?schema=public

# Cryptographic JWT Secrets (minimum 32 characters recommended for production)
JWT_ACCESS_SECRET=pilotmama-development-access-secret-minimum-32-chars-long
JWT_REFRESH_SECRET=pilotmama-development-refresh-secret-minimum-32-chars-long

# JWT Lifecycles
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Permitted Frontend Origin for CORS
CORS_ORIGIN=http://localhost:5173

# Optional AI Gateway Keys (Leave blank to use robust heuristic fallback engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# S3-Compatible Storage (AWS S3 or Cloudflare R2 - Planned)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Frontend Environment Variables (for frontend/.env)
# VITE_API_URL=http://localhost:5000/api/v1
# VITE_APP_ENV=development
