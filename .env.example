# ==============================================================================
# Pilot Mama V1 - Environment Configuration Template
# ==============================================================================
# DO NOT COMMIT REAL PRODUCTION SECRETS TO REPOSITORY.
# Copy this file to .env or backend/.env and populate with deployment variables.

# Runtime Environment (development | test | production)
NODE_ENV=development

# Server Port
PORT=5000

# PostgreSQL Connection String (Prisma format)
# Local: postgresql://postgres:postgres@localhost:5432/pilotmama?schema=public
# Production: Render Managed PostgreSQL connection string with SSL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pilotmama?schema=public

# Cryptographic JWT Secrets (minimum 32 characters recommended for production)
JWT_ACCESS_SECRET=pilotmama-development-access-secret-minimum-32-chars-long
JWT_REFRESH_SECRET=pilotmama-development-refresh-secret-minimum-32-chars-long

# JWT Lifecycles
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Permitted Frontend Origin for CORS
CORS_ORIGIN=http://localhost:5173

# Optional AI Gateway Keys (Leave blank to use robust heuristic fallback engine)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Persistent Object Storage (AWS S3, Cloudflare R2, MinIO, or local)
# Set STORAGE_PROVIDER to 's3' or 'r2' for production persistence
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Razorpay Payment Gateway (Sprint 7)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Dedicated Administrator Provisioning (Part 28)
# Password must be securely supplied outside source control; never commit production passwords.
ADMIN_EMAIL=admin@pilotmama.io
ADMIN_PASSWORD=SetSecurePasswordHereOutsideSourceControl123!

# Production Automatic Job Source Scheduler Secret
# Used by GitHub Actions workflow to trigger scheduled synchronization every 6 hours
JOB_SYNC_CRON_SECRET=

# Frontend / App Base URL (used for OAuth redirect callbacks)
APP_BASE_URL=http://localhost:5173

# Google OAuth 2.0 Credentials (Server-side)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn OpenID Connect Credentials (Server-side)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Frontend Environment Variables (for frontend/.env)
# VITE_API_URL=http://localhost:5000/api/v1
# VITE_APP_ENV=development
# VITE_GOOGLE_CLIENT_ID=
